          <li data-en="Touch-screen scoring &amp; AV" data-ar="أنظمة تسجيل باللمس وسمعية بصرية">Touch-screen scoring &amp; AV</li>
          <li data-en="Footwear &amp; accessories" data-ar="أحذية وإكسسوارات">Footwear &amp; accessories</li>
