</div>

<style>
.news-ticker-wrap{display:flex;align-items:center;background:#0d2540;border-bottom:1px solid rgba(200,168,75,.35);height:36px;overflow:hidden;position:relative;z-index:99}
.ticker-label{background:var(--gold, #C8A84B);color:#0B1F3A;font-size:.7rem;font-weight:700;padding:0 .9rem;height:100%;display:flex;align-items:center;white-space:nowrap;flex-shrink:0}
.ticker-track-outer{flex:1;overflow:hidden;height:100%;position:relative}
.ticker-track{display:flex;align-items:center;gap:0;white-space:nowrap;animation:ticker-scroll 30s linear infinite;width:max-content}
.ticker-track:hover{animation-play-state:paused}
.ticker-item a{color:rgba(244,246,250,.85);text-decoration:none;font-size:.75rem;padding:0 1.5rem;transition:color .2s}
.ticker-item a:hover{color:#C8A84B}
.ticker-sep{color:rgba(200,168,75,.4);font-size:.6rem;padding:0 .25rem;flex-shrink:0}
.ticker-close{background:transparent;border:none;color:rgba(244,246,250,.4);font-size:.7rem;cursor:pointer;padding:0 .75rem;height:100%;flex-shrink:0;transition:color .2s}
.ticker-close:hover{color:#C8A84B}
@keyframes ticker-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<script>
(function(){
  var track = document.getElementById('tickerTrack');
  if(track){
    var clone = track.innerHTML;
    track.innerHTML = clone + clone;
  }
})();
</script>


